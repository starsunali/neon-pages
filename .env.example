# ============================================================
# Neon Pages — Environment Configuration
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# Global
# ------------------------------------------------------------
# The public domain (no protocol, e.g. example.com)
DOMAIN=example.com
# Public entry URL (used for QR codes and public page links)
PUBLIC_BASE_URL=https://${DOMAIN}
NODE_ENV=production
TIMEZONE=UTC

# ------------------------------------------------------------
# PostgreSQL (used by both the compose stack and the backend)
# ------------------------------------------------------------
POSTGRES_DB=neonpages
POSTGRES_USER=neonpages
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------
# Backend (NestJS)
# ------------------------------------------------------------
BACKEND_PORT=3000
# Base URL the frontend uses to reach the API (browser-facing)
BACKEND_PUBLIC_URL=https://${DOMAIN}/api
# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=https://${DOMAIN}
# QR code output directory (inside backend container)
QR_STORAGE_DIR=/app/uploads/qr
# Bcrypt cost factor (10–14)
BCRYPT_ROUNDS=12
# Rate limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15

# ------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=https://${DOMAIN}/api
NEXT_PUBLIC_SITE_URL=https://${DOMAIN}

# ------------------------------------------------------------
# Nginx
# ------------------------------------------------------------
NGINX_PORT=80
NGINX_HTTPS_PORT=443
# E-mail for Let's Encrypt certificates (certbot)
LETSENCRYPT_EMAIL=admin@${DOMAIN}

# ------------------------------------------------------------
# Docker
# ------------------------------------------------------------
COMPOSE_PROJECT_NAME=neonpages
# Frontend/backend image tags used by docker-compose.prod.yml
IMAGE_TAG=latest
