# Backend environment (Docker Compose injects these automatically; local dev
# copies this file to .env). All values must match the root .env.example.
DATABASE_URL=postgresql://neonpages:change-me-strong-db-password@localhost:5432/neonpages?schema=public
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3001
JWT_ACCESS_SECRET=dev-only-access-secret
JWT_REFRESH_SECRET=dev-only-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
QR_STORAGE_DIR=uploads/qr
PUBLIC_BASE_URL=http://localhost:3001
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_THRESHOLD=5
ACCOUNT_LOCK_MINUTES=15
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_PASSWORD=User@12345